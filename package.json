{
  "name": "ci-failure-analyzer",
  "version": "0.1.0",
  "private": true,
  "description": "CI 실패 로그를 AI가 분석해 PR 댓글과 이슈로 남기는 연습 프로젝트",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "jest",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "jest": "^30.5.2",
    "jest-junit": "^17.0.0",
    "prettier": "^3.10.1"
  },
  "jest": {
    "reporters": [
      "default",
      [
        "jest-junit",
        {
          "outputDirectory": ".",
          "outputName": "report.xml"
        }
      ]
    ]
  }
}
